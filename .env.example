# Cloudflare Workers / Pages
# 在控制台创建 KV 命名空间后，把 id 填到 wrangler.toml 里，或直接用变量：
KV_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 访问控制 ----
# 可选：旧版静态访问令牌（前端「设置 → 服务器 → 网站令牌」需填同样的值）
SITE_TOKEN=
# 可选：访问密码。配置后打开网站需要先输入密码，才能查看作业（令牌有效 7 天）
SITE_PASSWORD=
# 可选：编辑令牌。配置后修改作业需要在「设置 → 服务器 → 访问权限」填写同样的值
EDIT_TOKEN=
# 可选：访问令牌签名密钥。修改它可让所有已登录的访客失效；留空则使用 SITE_PASSWORD
AUTH_SECRET=

# 可选：限制允许的来源，默认 *
CORS_ORIGIN=

# ---- 管理后台（/admin）----
# 必填：管理密码。不设置时管理接口返回 503，后台保持禁用
ADMIN_PASSWORD=
# 可选：令牌签名密钥。修改它可让所有已登录会话立即失效；留空则使用 ADMIN_PASSWORD
ADMIN_SECRET=

# ---- Vercel 部署时需要（Upstash Redis 免费版）----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
