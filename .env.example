# ---- 访问控制 ----
# 可选：只读密码。配置后打开网站需要先输入密码，用该密码登录只能查看作业（令牌有效 7 天）
SITE_PASSWORD=
# 可选：可写密码。与只读密码共用同一个输入框，用该密码登录可以查看并修改作业
EDIT_PASSWORD=
# 可选：访问令牌签名密钥。修改它可让所有已登录的访客失效；留空则由两个密码派生
AUTH_SECRET=

# 可选：限制允许的跨域来源（站点自身固定同源调用，此项供外部客户端使用），默认 *
CORS_ORIGIN=

# ---- 管理后台（/admin）----
# 必填：管理密码。不设置时管理接口返回 503，后台保持禁用
ADMIN_PASSWORD=
# 可选：令牌签名密钥。修改它可让所有已登录会话立即失效；留空则使用 ADMIN_PASSWORD
ADMIN_SECRET=

# ---- Vercel 部署时需要（Upstash Redis 免费版）----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
